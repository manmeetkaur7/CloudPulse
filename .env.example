# Public URL used by the Next.js dashboard to reach the local API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated origins permitted by the FastAPI CORS policy.
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection used by the FastAPI backend and Alembic migrations.
DATABASE_URL=postgresql+psycopg://cloudpulse:cloudpulse@localhost:5432/cloudpulse

# Optional Redis cache and cross-instance real-time notification service.
REDIS_URL=redis://localhost:6379/0
